# HackerOne Hacker API credentials. Never commit real credentials.
HACKERONE_USERNAME=replace_me
HACKERONE_API_TOKEN=replace_me
HACKERONE_BASE_URL=https://api.hackerone.com

# Safety / workflow
DRY_RUN=true
ALLOW_ACTIVE_TESTS=false
H1_ENABLE_SUBMISSION=false
REQUESTS_PER_SECOND=1
RESEARCH_USER_AGENT=H1-Bounty-Agent/0.4

# Vercel private durable storage
BLOB_READ_WRITE_TOKEN=replace_me

# Authenticated review dashboard
DASHBOARD_USER=replace_me
DASHBOARD_PASSWORD=replace_me
DASHBOARD_SECRET=replace_me
CRON_SECRET=replace_me

# Hosted LLM option for Vercel. Ollama remains available locally.
# HF provides a small free monthly inference credit for free accounts; usage limits can change.
LLM_PROVIDER=huggingface
HF_TOKEN=replace_me
LLM_MODEL=openai/gpt-oss-120b:groq

# Autonomous research is OFF by default.
# Enable only after reviewing and explicitly allowing each program.
AUTONOMOUS_RESEARCH=false
AUTONOMOUS_MAX_PROGRAMS=3
AUTONOMOUS_MAX_TARGETS_PER_PROGRAM=2
RESEARCH_PROGRAM_ALLOWLIST=
