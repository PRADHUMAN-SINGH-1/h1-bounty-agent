# HackerOne Hacker API credentials. Never commit the real token.
HACKERONE_USERNAME=replace_me
HACKERONE_API_TOKEN=replace_me
HACKERONE_BASE_URL=https://api.hackerone.com

# Local LLM (Ollama = no per-request API bill)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b

# Safety / workflow gates
DRY_RUN=true
ALLOW_ACTIVE_TESTS=false
H1_ENABLE_SUBMISSION=false
REQUESTS_PER_SECOND=1
RESEARCH_USER_AGENT=H1-Bounty-Agent/0.2
